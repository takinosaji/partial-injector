{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/post_tool_use_lint_and_sast.py",
            "if": "Edit(*.py)|Write(*.py)",
            "statusMessage": "Checking ruff + bandit..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/stop_lint_and_sast.py",
            "statusMessage": "Running ruff format + fix + bandit..."
          }
        ]
      }
    ]
  }
}
